# 복사해서 .env 로 — .env 는 커밋하지 않는다(공개 레포). 값은 사람이 넣는다.

# Google AI Studio 에서 받은 Gemini API 키. 팀 키 하나를 서버에만 둔다 — 사용자는 키를 넣지 않는다
GEMINI_API_KEY=

# 쓸 모델 — 쉼표로 순서대로. 앞 모델을 「지금 못 쓰면」(503 · 429 · 5xx · 404 · 시간 초과) 다음으로 넘어간다.
# 바꾸면 ETC docs/ai-scope.md 도 같은 PR 에서
LLM_MODELS=gemini-3.5-flash,gemini-3.8-flash,gemini-3.5-flash-lite

# 폴백 · 다시 시도까지 합친 LLM 제한 시간(초). BE 제한 시간(제안 120초)보다 짧게
LLM_TIMEOUT_SECONDS=100

# 모델 하나를 한 번 부를 때 제한 시간(초) — 넘으면 다음 모델로
LLM_CALL_TIMEOUT_SECONDS=45

# 한 번에 받는 텍스트 최대 글자 수. BE 한도보다 작으면 안 된다 — 바꾸면 ETC docs/contracts/ai-api.md 도
MAX_TEXT_CHARS=50000

# LLM 출력이 규칙을 벗어날 때 몇 번까지 부르나(처음 포함)
LLM_MAX_ATTEMPTS=2
