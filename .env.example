# 복사해서 .env 로 — .env 는 커밋하지 않는다(공개 레포). 값은 사람이 넣는다.

# 서버 운영용 팀 키 — 사용자는 키를 넣지 않는다(사용자 자기 키 = BYOK 는 백로그)
# 기본: OpenAI 유료 API(팀 크레딧 — 입력을 학습에 쓰지 않음)
OPENAI_API_KEY=
# 선택: 있으면 OpenAI 를 못 쓸 때 넘어간다. 무료 등급은 입력이 Google 제품 개선에 쓰일 수 있고 하루 한도가 작다
GEMINI_API_KEY=

# 쓸 모델 — 「제공사:모델」을 쉼표로 순서대로(제공사 openai · gemini). 키가 없는 제공사는 건너뛴다.
# 앞 모델을 「지금 못 쓰면」(404 · 429 · 5xx · 시간 초과) 다음으로. 바꾸면 ETC docs/ai-scope.md 도 같은 PR 에서
# 고르는 규칙: 지원 중인 모델을 최근 세대부터, 비싼 등급(astra · pro) · 지원 종료 예정은 뺀다
# 비워 두면 코드 기본값(app/config.py)을 쓴다 — 복사해 둔 옛 목록이 새 기본값을 덮지 않게 주석으로 둔다
# LLM_MODELS=openai:gpt-6-luna,openai:gpt-6.1-terra,openai:gpt-5.4-mini,gemini:gemini-3.5-flash,gemini:gemini-3.5-flash-lite
# 매칭(/match) · 초안(/draft)만 따로 — 규칙은 LLM_MODELS 와 같다. 순서를 고른 근거는 app/config.py
# MATCH_LLM_MODELS=openai:gpt-6.1-terra,openai:gpt-6-luna,openai:gpt-5.4-mini,gemini:gemini-3.5-flash,gemini:gemini-3.5-flash-lite
# 홈 입력 가르기(/route)만 따로 — 동기 호출이라 빠른 모델부터. 순서를 고른 근거는 app/config.py
# ROUTE_LLM_MODELS=openai:gpt-6.1-terra,openai:gpt-6-luna,openai:gpt-5.4-mini,gemini:gemini-3.5-flash,gemini:gemini-3.5-flash-lite

# 폴백 · 다시 시도까지 합친 LLM 제한 시간(초). BE 제한 시간(제안 120초)보다 짧게
LLM_TIMEOUT_SECONDS=100

# 입구 셋(/route …) — 사용자가 화면에서 기다리는 동기 호출. 폴백 · 다시 시도까지 합친 제한 시간(초).
# BE AI_SYNC_TIMEOUT_SECONDS(60초)보다 짧게 — 계약 ai-api 「입구 셋」
LLM_SYNC_TIMEOUT_SECONDS=50
# 입구 셋에서 모델 하나를 한 번 부를 때 제한(초) — 넘으면 다음 모델로. 50초 안에 다음 모델을 부를 수 있게 짧게
LLM_SYNC_CALL_TIMEOUT_SECONDS=20

# 모델 하나를 한 번 부를 때 제한 시간(초) — 넘으면 다음 모델로
LLM_CALL_TIMEOUT_SECONDS=45

# 한 번에 받는 텍스트 최대 글자 수. BE 한도보다 작으면 안 된다 — 바꾸면 ETC docs/contracts/ai-api.md 도
MAX_TEXT_CHARS=50000

# /match 한 번에 받는 문항 · 경험 본문 · 근거 · 보완 글자 수 합 최대 — 바꾸면 ETC docs/contracts/ai-api.md 도
MAX_MATCH_CHARS=100000

# LLM 출력이 규칙을 벗어날 때 몇 번까지 부르나(처음 포함)
LLM_MAX_ATTEMPTS=2
